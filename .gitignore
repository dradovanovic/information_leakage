# Ignore Python bytecode files
__pycache__/
*.pyc

# Ignore IDE settings
.idea/
.vscode/

# Ignore folders for data and models
/data/
/extracted_features/
/results/models
/results/predictions/logs
/outputs/

# Ignore other system or editor-specific files
.DS_Store
Thumbs.db

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Emacs
.#*
# Experiment outputs
/results/

# Local environments
.venv/
